<?xml version="1.0" encoding="UTF-8"?>
<manifest>

  <remote name="mica"
          fetch="https://github.com/Project-Mica/"
          revision="16-qpr1"  />

  <remote name="lab"
          fetch="https://github.com/c0smic-Lab/"
          revision="mica"  />
  
  <remote name="gitlab"
          fetch="https://gitlab.com/" />

  <!-- General Repos -->
  <project path="bootable/recovery" name="bootable_recovery" remote="lab" />
  <project path="bootable/deprecated-ota" name="bootable_deprecated-ota" remote="lab" />
  <project path="bionic" name="bionic" remote="lab" />
  <project path="device/lineage/sepolicy" name="device_lineage_sepolicy" remote="mica" />

  <!-- Build Repos -->
  <project path="build/make" name="build" remote="mica" >
   <copyfile src="core/root.mk" dest="Makefile" />
   <linkfile src="CleanSpec.mk" dest="build/CleanSpec.mk" />
   <linkfile src="buildspec.mk.default" dest="build/buildspec.mk.default" />
   <linkfile src="core" dest="build/core" />
   <linkfile src="envsetup.sh" dest="build/envsetup.sh" />
   <linkfile src="target" dest="build/target" />
   <linkfile src="tools" dest="build/tools" />
  </project>
  <project path="build/soong" name="build_soong" remote="mica" >
   <linkfile src="root.bp" dest="Android.bp" />
   <linkfile src="bootstrap.bash" dest="bootstrap.bash" />
  </project>

  <!-- Kernel -->
  <project path="kernel/configs" name="kernel_configs" groups="vts,pdk" remote="lab" />

  <!-- External Repos -->
  <project path="external/bouncycastle" name="external_bouncycastle" remote="mica" />
  <project path="external/dtc" name="external_dtc" remote="lab" />
  <project path="external/gptfdisk" name="external_gptfdisk" remote="lab" />
  <project path="external/mksh" name="external_mksh" remote="lab" />
  <project path="external/e2fsprogs" name="external_e2fsprogs" remote="lab" />
  <project path="external/tinycompress" name="external_tinycompress" remote="lab" />
  <project path="external/wpa_supplicant_8" name="external_wpa_supplicant_8" remote="lab" />
  <project path="external/zstd" name="external_zstd" groups="pdk" remote="lab" />

  <!-- Frameworks Repos -->
  <project path="frameworks/av" name="frameworks_av" remote="mica" />
  <project path="frameworks/base" name="frameworks_base" remote="mica" />
  <project path="frameworks/native" name="frameworks_native" remote="mica" />

  <!-- Hardware repos -->
  <project path="hardware/google/pixel" name="hardware_google_pixel" remote="mica" />
  <project path="hardware/interfaces" name="hardware_interfaces" remote="lab" />
  <project path="hardware/libhardware" name="hardware_libhardware" remote="mica" />
  <project path="hardware/lineage/interfaces" name="hardware_lineage_interfaces" remote="mica" />
  <project path="hardware/lineage/compat" name="hardware_lineage_compat" remote="mica" />
  <project path="hardware/qcom/wlan" name="hardware_qcom_wlan" remote="lab" />
  <project path="hardware/qcom-caf/common" name="hardware_qcom-caf_common" groups="qcom" remote="mica" >
    <!-- add guard for AOSP hardware/qcom dir -->
    <linkfile src="os_pickup_aosp.mk" dest="hardware/qcom/Android.mk" />
    <!-- add guards for CAF repositories -->
    <linkfile src="os_pickup_sepolicy_vndr.mk" dest="device/qcom/sepolicy_vndr/SEPolicy.mk" />
    <linkfile src="os_pickup_qssi.bp" dest="hardware/qcom-caf/msm8953/Android.bp" />
    <linkfile src="os_pickup.bp" dest="hardware/qcom-caf/msm8998/Android.bp" />
    <linkfile src="os_pickup_qssi.bp" dest="hardware/qcom-caf/sdm660/Android.bp" />
    <linkfile src="os_pickup_qssi.bp" dest="hardware/qcom-caf/sdm845/Android.bp" />
    <linkfile src="os_pickup_qssi.bp" dest="hardware/qcom-caf/sm8150/Android.bp" />
    <linkfile src="os_pickup_qssi.bp" dest="hardware/qcom-caf/sm8250/Android.bp" />
    <linkfile src="os_pickup_qssi.bp" dest="hardware/qcom-caf/sm8350/Android.bp" />
    <linkfile src="os_pickup_qssi.bp" dest="hardware/qcom-caf/sm8450/Android.bp" />
    <linkfile src="os_pickup_qssi.bp" dest="hardware/qcom-caf/sm8550/Android.bp" />
    <linkfile src="os_pickup_qssi.bp" dest="hardware/qcom-caf/sm8650/Android.bp" />
    <linkfile src="os_pickup_qssi.bp" dest="hardware/qcom-caf/sm8750/Android.bp" />
  </project>

  <!-- Packages Repos -->
  <project path="packages/apps/Settings" name="packages_apps_Settings" remote="mica" />
  <project path="packages/apps/ColumbusService" name="packages_apps_ColumbusService" remote="mica" />
  <project path="packages/modules/Bluetooth" name="packages_modules_Bluetooth" remote="mica" />
  <project path="packages/modules/Connectivity" name="packages_modules_Connectivity" groups="pdk-cw-fs,pdk-fs" remote="lab" />

  <!-- System Repos -->
  <project path="system/core" name="system_core" remote="lab" />
  <project path="system/sepolicy" name="system_sepolicy" remote="mica" />
  <project path="system/update_engine" name="system_update_engine" remote="mica" />
  <project path="system/libhidl" name="system_libhidl" remote="lab" />
  <project path="system/vold" name="system_vold" remote="lab" />
  <project path="system/libziparchive" name="system_libziparchive" remote="lab" />

  <!-- Vendor Repos -->
  <project path="vendor/mica" name="vendor_mica" remote="mica" />
  <project path="vendor/gms" name="vendor_gms" remote="mica" />
</manifest>
